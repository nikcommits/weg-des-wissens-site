---
import BaseLayout from '../layouts/BaseLayout.astro';
const baseUrl = `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Impressum | Weg des Wissens e. V." description="Impressum von Weg des Wissens e. V.">
  <main id="inhalt" class="legal shell">
    <p class="label">Rechtliche Informationen</p>
    <h1>Impressum</h1>
    <section><h2>Angaben gemäß § 5 DDG</h2><p>Weg des Wissens e. V.<br />Am Alten Güterbahnhof 27<br />50825 Köln</p></section>
    <section><h2>Vereinsregister</h2><p>Registergericht: Amtsgericht Köln<br />Registernummer: VR 21594</p></section>
    <section><h2>Vertretung</h2><p>Allein vertretungsberechtigt: Wisam Kouli</p></section>
    <section><h2>Kontakt</h2><p><a href="mailto:wisamkouli@hotmail.de">wisamkouli@hotmail.de</a></p></section>
    <section><h2>Gemeinnützigkeit</h2><p>Dem Verein liegt ein Feststellungsbescheid nach § 60a AO vor.</p></section>
    <section><h2>Verbraucherstreitbeilegung</h2><p>Wir sind weder bereit noch verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p></section>
    <p class="legal-back"><a href={baseUrl}>Zur Startseite</a></p>
  </main>
  <footer><div class="shell footer"><div class="brand"><img src={`${baseUrl}images/wdw-logo.png`} alt="" width="38" height="34"/><span>Weg des Wissens</span></div><nav aria-label="Rechtliches"><a href={`${baseUrl}datenschutz`}>Datenschutz</a><a href={`${baseUrl}impressum`} aria-current="page">Impressum</a><a href={baseUrl}>Zur Anmeldung</a></nav></div></footer>
</BaseLayout>
